{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": {
      "description": "API URL for the backend",
      "default": "http://localhost:3001/api"
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
