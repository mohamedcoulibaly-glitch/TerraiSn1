PORT=3001
NODE_ENV=development
# SKIP_SEED=true
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:8080
# PayDunya = sandbox/dev/tests | PayTech = PRODUCTION officielle
# Synonyme : PAYMENT_GATEWAY (historique)
PAYMENT_PROVIDER=paydunya
PAYMENT_MODE=production
# Alias historique (si PAYMENT_PROVIDER absent) :
# PAYMENT_GATEWAY=paydunya
PAYTECH_ENABLED=true
PAYTECH_MOCK=false
PAYTECH_BASE_URL=https://paytech.sn/api
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_API_URL=
PAYTECH_REFUND_URL=
# test | prod — passer en prod uniquement avec domaine HTTPS TerrainSN
PAYTECH_ENV=test
# Obligatoire en HTTPS. Exemple prod:
# PAYTECH_IPN_URL=https://api.ton-domaine.sn/webhook/paytech
# PAYTECH_SUCCESS_URL=https://ton-domaine.sn/reservation/succes
# PAYTECH_CANCEL_URL=https://ton-domaine.sn/reservation/annule
PAYTECH_IPN_URL=
PAYTECH_SUCCESS_URL=
PAYTECH_CANCEL_URL=

# PayDunya sandbox (app TerrainSN1) — UNIQUEMENT Dev/Test
PAYDUNYA_MODE=test
PAYDUNYA_STORE_NAME=TerrainSN1
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_RETURN_URL=
PAYDUNYA_CANCEL_URL=
PAYDUNYA_PAYOUT_ENABLED=true
# Sandbox disburse (clés test_*) — false uniquement avec clés LIVE + option PER
PAYDUNYA_DISBURSE_USE_SANDBOX=true
# PAYDUNYA_PAYOUT_CALLBACK_URL=https://ton-tunnel/webhook/paydunya
# Si sandbox PayDunya renvoie « Too many connections », bascule auto vers PayTech (défaut: true)
# PAYDUNYA_FALLBACK_PAYTECH=true
# PAYDUNYA_RETRY_MAX=3
# PAYDUNYA_RETRY_BASE_MS=800
WHATSAPP_MOCK=false
# WhatsApp uniquement via OpenWA (plus de whatsapp-web.js local)
OPENWA_BASE_URL=https://mywa.tickets-place.net
OPENWA_API_KEY=
OPENWA_SESSION_PREFIX=terrainsn
# Optionnel si le serveur OpenWA ne peut plus créer de sessions (Chromium) :
# OPENWA_SHARED_SESSION_ID=uuid-session-deja-ready
# OPENWA_PLATFORM_SESSION_ID=uuid-session-plateforme
# Session plateforme (OTP joueur) : /whatsapp-qr
# Chaque gérant connecte SON numéro dans l’espace gérant (QR dédié OpenWA)
# Doit être HTTPS en prod (PayTech refuse localhost)
APP_DOMAIN=https://ton-domaine.sn
# Payouts gérants (sortie d'argent). Laisser false tant que PayTech n'est pas autorisé à payer.
PAYTECH_PAYOUT_ENABLED=false
PAYTECH_PAYOUT_URL=
# WhatsApp équipe dév (file retraits manuels)
WHATSAPP_DEV_NUMBER=

# Web Push (generer avec: node scripts/generate-vapid-keys.js)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@terrainsn.com
