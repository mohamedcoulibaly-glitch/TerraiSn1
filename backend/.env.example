PORT=3001
NODE_ENV=development
JWT_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=http://localhost:8080
PAYMENT_MODE=production
PAYTECH_ENABLED=true
PAYTECH_MOCK=false
PAYTECH_BASE_URL=https://paytech.sn/api
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_API_URL=
PAYTECH_REFUND_URL=
# test | prod — passer en prod uniquement avec domaine HTTPS TerrainSN
PAYTECH_ENV=test
# Obligatoire en HTTPS. Exemple prod:
# PAYTECH_IPN_URL=https://api.ton-domaine.sn/webhook/paytech
# PAYTECH_SUCCESS_URL=https://ton-domaine.sn/reservation/succes
# PAYTECH_CANCEL_URL=https://ton-domaine.sn/reservation/annule
PAYTECH_IPN_URL=
PAYTECH_SUCCESS_URL=
PAYTECH_CANCEL_URL=
WHATSAPP_MOCK=false
# openwa | baileys | local — préférence générale
WHATSAPP_ENGINE=openwa
# Appairage QR : baileys local (recommandé — OpenWA distant reste souvent bloqué en qr_ready)
WHATSAPP_LINK_ENGINE=baileys
# true = bascule Baileys si OpenWA linking échoue
WHATSAPP_FALLBACK_BAILEYS=true
# WhatsApp via OpenWA distant (envoi) + Baileys local (appairage)
OPENWA_BASE_URL=https://mywa.tickets-place.net
OPENWA_API_KEY=
OPENWA_SESSION_PREFIX=terrainsn
# Optionnel si le serveur OpenWA ne peut plus créer de sessions (Chromium) :
# OPENWA_SHARED_SESSION_ID=uuid-session-deja-ready
# OPENWA_PLATFORM_SESSION_ID=uuid-session-plateforme
# Session plateforme (OTP joueur) : /whatsapp-qr
# Chaque gérant connecte SON numéro dans l’espace gérant (QR dédié)
# Doit être HTTPS en prod (PayTech refuse localhost)
APP_DOMAIN=https://ton-domaine.sn
# PostgreSQL (Docker Compose : docker compose up -d)
DATABASE_URL=postgresql://terrainsn:terrainsn@localhost:5433/terrainsn
# DB_PATH=  # déprécié (SQLite / sql.js)

# Web Push (generer avec: node scripts/generate-vapid-keys.js)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@terrainsn.com

# --- Alertes développeur (e-mail + WhatsApp plateforme) ---
# false en dev ; passer à true en prod
BUG_ALERT_ENABLED=false
BUG_ALERT_THROTTLE_MS=300000
BUG_ALERT_EMAILS=babacarec12@gmail.com:Babacar SENE,babacarmohamed523@gmail.com:Mohamed,mohamedcoulibaly3129@gmail.com:Mohamed Coulibaly
BUG_ALERT_WHATSAPP=+221750147138:Babacar SENE,+221778261225:Mohamed Coulibaly
# Vide = numéro de la session WhatsApp plateforme (superadmin)
BUG_ALERT_WHATSAPP_SENDER=
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TerrainSN <pms@resto-smart.com>
PLATFORM_NOTIFICATION_EMAIL=pms@resto-smart.com
