PORT=3001
NODE_ENV=development
# SKIP_SEED=true
# FORCE_SEED=false
JWT_SECRET=
JWT_REFRESH_SECRET=
# Durée de l'access token (ex: 15m, 30m, 1h). Défaut backend: 30m
JWT_EXPIRY=30m
# Origines front (joueur :5173, pro :5174). Prod : app. + pro.terrainsn.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081
# Cookie refresh : lax (même site / Render) | none (front séparé HTTPS)
COOKIE_SAMESITE=lax

# Domaines front séparés (redirections paiement)
# APP_DOMAIN_JOUEUR=http://localhost:5173
# APP_DOMAIN_PRO=http://localhost:5174
# APP_DOMAIN=http://localhost:5173

# Base SQLite locale (sql.js) — AUCUNE DATABASE_URL requise.
# Chemins prod (Render / Docker) — laissés vides en local
# DB_PATH=/data/terrainsn.db
# UPLOAD_ROOT=/data/uploads
# PUBLIC_DIR=../frontend-joueur/dist
# PRO_PUBLIC_DIR=../frontend-pro/dist
# ADMIN_PUBLIC_DIR=../admin-frontend/dist

# ─── Passerelle paiement en ligne (Wave / Orange Money) ───
# Synonyme historique : PAYMENT_GATEWAY
PAYMENT_PROVIDER=paytech
# production = vrai checkout PayTech/PayDunya (réservations joueur toujours en réel)
# simulation = page locale uniquement pour certains flux hors joueur (dettes/dev)
PAYMENT_MODE=production
# PAYMENT_GATEWAY=paytech
PAYTECH_ENABLED=true
PAYTECH_MOCK=false
PAYTECH_BASE_URL=https://paytech.sn/api
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_API_URL=
PAYTECH_REFUND_URL=
# test | prod — passer en prod uniquement avec domaine HTTPS TerrainSN
PAYTECH_ENV=test
# Obligatoire en HTTPS. Exemple prod :
# Prod : https://terraisn1-1.onrender.com/webhook/paytech (etc.)
# PAYTECH_IPN_URL=https://terraisn1-1.onrender.com/webhook/paytech
# PAYTECH_SUCCESS_URL=https://terraisn1-1.onrender.com/paytech/success
# PAYTECH_CANCEL_URL=https://terraisn1-1.onrender.com/paytech/cancel
PAYTECH_IPN_URL=
PAYTECH_SUCCESS_URL=
PAYTECH_CANCEL_URL=
# Payouts gérants (API Transfer). Laisser false tant que non autorisé.
# Pour activer en prod :
#   1) PAYTECH_PAYOUT_ENABLED=true + clés live + wallet PayTech abondé
#   2) contrat terrain : paiement_production=1 + Wave/OM vérifiés
#   3) APP_DOMAIN HTTPS + PAYTECH_IPN_URL joignable
#   4) WHATSAPP_DEV_NUMBER (alertes / file retraits manuels)
PAYTECH_PAYOUT_ENABLED=false
# Défaut : https://paytech.sn/api/transfer/transferFund
PAYTECH_PAYOUT_URL=

# ─── PayDunya (passerelle alternative : PAYMENT_PROVIDER=paydunya) ───
# test = sandbox (dev/test uniquement) | live = paiements réels
PAYDUNYA_MODE=test
PAYDUNYA_STORE_NAME=TerrainSN1
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_CALLBACK_URL=
PAYDUNYA_RETURN_URL=
PAYDUNYA_CANCEL_URL=
PAYDUNYA_PAYOUT_ENABLED=true
# Sandbox disburse (clés test_*) — false uniquement avec clés LIVE + option PER
PAYDUNYA_DISBURSE_USE_SANDBOX=true
# PAYDUNYA_PAYOUT_CALLBACK_URL=https://ton-tunnel/webhook/paydunya
# Si la sandbox PayDunya renvoie « Too many connections », bascule auto vers PayTech (défaut: true)
# PAYDUNYA_FALLBACK_PAYTECH=true
# PAYDUNYA_RETRY_MAX=3
# PAYDUNYA_RETRY_BASE_MS=800

# ─── WhatsApp — OpenWA uniquement (pas de Baileys / whatsapp-web.js local) ───
WHATSAPP_MOCK=false
OPENWA_BASE_URL=https://mywa.tickets-place.net
OPENWA_API_KEY=
OPENWA_SESSION_PREFIX=terrainsn
# Optionnel si le serveur OpenWA ne peut plus créer de sessions :
# OPENWA_SHARED_SESSION_ID=uuid-session-deja-ready
# OPENWA_PLATFORM_SESSION_ID=uuid-session-plateforme
# Durée de validité suivie pour les codes de jumelage (défaut 5 min)
# OPENWA_PAIRING_TTL_MS=300000
# Timeout HTTP OpenWA / attente session prête pour pairing
# OPENWA_HTTP_TIMEOUT_MS=45000
# OPENWA_PAIRING_WAIT_MS=75000
# Session plateforme (OTP joueur) : /whatsapp-qr
# Chaque gérant connecte SON numéro dans l'espace gérant (QR dédié OpenWA)
# WhatsApp équipe dév (file retraits manuels + alertes)
WHATSAPP_DEV_NUMBER=
# WHATSAPP_TEST_NUMBER=

# Doit être HTTPS en prod (PayTech refuse localhost)
# Sur Render : laissé vide => auto = RENDER_EXTERNAL_URL
APP_DOMAIN=https://terraisn1-1.onrender.com

# ─── Alertes bugs développeur (email + WhatsApp) ───
BUG_ALERT_ENABLED=true
# Délai minimal entre deux alertes identiques (ms) — défaut 5 min
BUG_ALERT_THROTTLE_MS=300000
# Destinataires (séparés par des virgules)
BUG_ALERT_EMAILS=
BUG_ALERT_WHATSAPP=

# ─── Email SMTP (alertes bugs) ───
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
# DEFAULT_FROM_EMAIL=TerrainSN <no-reply@ton-domaine.sn>

# ─── Web Push (générer avec : node scripts/generate-vapid-keys.js) ───
# Si absentes en prod : auto-générées + persistées près de DB_PATH.
# Régénération : superadmin > Intégrations (invalide tous les abonnements).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@terrainsn.com

# ─── Options runtime (facultatif) ───
# AUTH_RATE_LIMIT=1
# RATE_LIMIT=1
# LOG_JSON=1
# NGROK_API_URL=http://127.0.0.1:4040/api/tunnels
# RENDER_EXTERNAL_URL=
# BOOKING_REQUIRE_GERANT_WA=false
# WHATSAPP_EQUIPE_DEV=
# WHATSAPP_RETRY_INTERVAL_MS=60000
# WHATSAPP_RETRY_MEMORY=1
# PAYTECH_IPN_AUTO=false
# PAYDUNYA_API_BASE=
# PAYDUNYA_DISBURSE_API_BASE=
# PLATFORM_NOTIFICATION_EMAIL=
