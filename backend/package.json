{
  "name": "terrainsn-server",
  "version": "1.0.0",
  "description": "Backend API TerrainSN",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --ignore data/ --ignore uploads/ --ignore node_modules/ index.js",
    "seed": "node seed.js",
    "seed:demo": "node scripts/seed_commodites_demo.js",
    "seed:mohamed": "node scripts/seed-mohamed.js",
    "migrate": "node scripts/migrate.js",
    "setup": "node scripts/migrate.js && node seed.js",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "whatsapp:test": "node scripts/test-whatsapp.js"
  },
  "keywords": [],
