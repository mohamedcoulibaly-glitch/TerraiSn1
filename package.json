{
  "name": "terrainsn-dev",
  "private": true,
  "version": "1.0.0",
  "description": "TerrainSN — commandes de développement unifiées (backend + frontends)",
  "scripts": {
    "dev": "node dev.js",
    "dev:app": "node dev.js --no-admin",
    "dev:admin": "node dev.js --no-frontend",
    "accounts": "node dev.js --accounts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "engines": {
    "node": ">=18"
  }
}
